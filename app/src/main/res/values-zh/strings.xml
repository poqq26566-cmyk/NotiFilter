    <!-- region OnboardingScreen -->
    <string name="onboarding_info_1">"NotiFilter 会运行一个低资源占用的后台服务,监听设备上的所有通知,并根据你的过滤器静默地进行管理。\n\n所有数据都不会离开设备;NotiFilter 没有网络访问权限。"</string>
    <string name="grant_permission">授予权限</string>
    <string name="onboarding_info_2">在部分设备上,“电池优化”功能可能导致通知关闭延迟,因此你仍可能会经历最初的短暂干扰。\n\n某些厂商的系统优化策略更为激进,你之后可能需要在应用设置中启用“前台运行”。</string>
    <string name="disable_optimization">关闭优化限制</string>
    <!-- endregion -->

    <!-- region AboutScreen -->
    <string name="about">关于</string>
    <string name="app_description">" 会监听设备上的所有通知,并静默管理符合你过滤器条件的通知。"</string>
    <string name="app_links"><![CDATA[基于<a href=\"https://github.com/BURG3R5/NotiFilter/blob/master/LICENSE\">GPLv3</a>协议授权<br/>源代码托管于<a href=\"https://github.com/BURG3R5/NotiFilter\">GitHub</a><br/>访问<a href=\"https://github.com/BURG3R5/NotiFilter/wiki\">项目wiki</a>了解更多]]></string>
    <string name="app_permissions"><![CDATA[权限说明<small><ul><li>BIND_NOTIFICATION_LISTENER_SERVICE:用于监听并响应通知</li><li>QUERY_ALL_PACKAGES:用于在添加过滤器时搜索已安装的应用</li><li>BIND_ACCESSIBILITY_SERVICE:用于执行“点击通知”类操作(如有)</li><li>POST_NOTIFICATIONS:用于执行“播放提示音”类操作(如有)</li><li>ACCESS_NOTIFICATION_POLICY:用于执行“关闭勿扰模式”类操作(如有)</li><li>REQUEST_IGNORE_BATTERY_OPTIMIZATIONS:用于执行“延迟关闭”类操作(如有)</li><li>FOREGROUND_SERVICE_SPECIAL_USE:用于可选地将核心服务提升为前台服务,避免系统激进的优化策略</li></ul>其他权限可能由第三方库用于管理任务,例如小组件更新。</small>]]></string>
    <string name="dev_credit"><![CDATA[由<a href=\"https://github.com/BURG3R5/\">BURG3R5</a>开发]]></string>
